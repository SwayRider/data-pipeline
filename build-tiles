#!/usr/bin/env python


import argparse
from pipeline.tiles_pipeline import TilesPipeline


def read_args() -> object:
    parser = argparse.ArgumentParser(description="SwayRider tiles builder")
    parser.add_argument(
            "--config",
            default="config/config.yml",
            help="Path to the config file")
    parser.add_argument(
            "--clean",
            action="store_true",
            help="Clean this pipeline's own temp and result data before running")
    parser.add_argument(
            "--clean-all",
            action="store_true",
            help="Clean all pipeline directories before running")
    parser.add_argument(
            "--tag",
            default="",
            help="Version tag (default: current date YYYY-MM-DD)")
    parser.add_argument(
            "--skip-download",
            action="store_true",
            help="Skip downloading OSM/Natural Earth data")
    parser.add_argument(
            "--skip-build",
            action="store_true",
            help="Skip building tiles (only upload)")
    parser.add_argument(
            "--upload",
            action="store_true",
            help="Deprecated: upload flag has no effect")
    parser.add_argument(
            "--no-parallel",
            action="store_true",
            help="Disable parallelization for easier debugging")
    parser.add_argument(
            "--gen-tile",
            type=str,
            default=None,
            help="Generate only a specific tile for testing (e.g., N50_E000)")
    parser.add_argument(
            "--with-service-roads",
            action="store_true",
            help="Include service roads (parking lots, driveways, etc.) in L2 extraction")

    args = parser.parse_args()
    return args


def main():
    args = read_args()
    pl = TilesPipeline(args)

    if not pl.initialize():
        print("Failed to initialize tiles pipeline")
        return

    if not pl.run():
        print("Failed to run tiles pipeline")
        return

    print("Tiles pipeline completed successfully")


if __name__ == "__main__":
    main()
