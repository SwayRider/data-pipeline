#!/usr/bin/env python


import argparse
from pipeline.pelias_pipeline import PeliasDataPipeline


def read_args() -> object:
    parser = argparse.ArgumentParser(description="SwayRider Pelias data builder")
    parser.add_argument(
            "--config",
            default="config/config.yml",
            help="Path to the config file")
    parser.add_argument(
            "--clean",
            action="store_true",
            help="Clean this pipeline's own temp and result data before running")
    parser.add_argument(
            "--clean-all",
            action="store_true",
            help="Clean all pipeline directories before running")
    parser.add_argument(
            "--tag",
            default="",
            help="Version tag (default: current date YYYY-MM-DD)")
    parser.add_argument(
            "--snapshot-only",
            action="store_true",
            help="Skip data import; start ES with existing data and run "
                 "snapshot+export only. Requires the temp/elasticsearch "
                 "directory to contain a previously completed import.")

    args = parser.parse_args()
    return args


def main():
    args = read_args()
    pl = PeliasDataPipeline(args)

    if not pl.initialize():
        print("Failed to initialize Pelias data pipeline")
        return

    if not pl.run():
        print("Failed to run Pelias data pipeline")
        return

    print("Pelias data pipeline completed successfully")


if __name__ == "__main__":
    main()
